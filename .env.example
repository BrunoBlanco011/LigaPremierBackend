# Copia este archivo a .env y llena los valores de tu proyecto Supabase
APP_NAME="Liga Premier API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publica (anon / publishable): solo se usa para /auth/login
SUPABASE_ANON_KEY=
# Clave secreta (service_role): NUNCA exponerla en el frontend
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: solo si tu proyecto sigue usando el JWT secret legado (HS256).
# Si se deja vacio, los tokens se validan con las llaves publicas (JWKS) del proyecto.
SUPABASE_JWT_SECRET=

TEAM_LOGOS_BUCKET=team-logos
MAX_LOGO_SIZE_MB=2

# ---------------------------------------------------------------- Seguridad (ver docs/SEGURIDAD.md)
# En produccion: ENVIRONMENT=production activa HSTS y oculta /docs
# Dominios desde los que se puede llamar a la API (Host). Vacio = cualquiera
ALLOWED_HOSTS=
# Vacio: /docs activo fuera de produccion. true/false para forzarlo
DOCS_ENABLED=
# true solo si la API corre detras de un proxy propio (Nginx, Render, Railway...)
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_MB=5
# Peticiones por minuto por IP (0 = sin limite)
RATE_LIMIT_PER_MINUTE=300
# Intentos de login fallidos por IP+correo antes de bloquear durante la ventana (segundos)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Clientes WebSocket (/api/v1/ws) simultaneos en total y por IP
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_IP=20
